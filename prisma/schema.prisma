generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  GESTOR_CARTELERA
  USUARIO
}

enum Clasificacion {
  ATP
  MAS_13
  MAS_16
  MAS_18
}

enum Categoria {
  ACCION
  COMEDIA
  DRAMA
  TERROR
  CIENCIA_FICCION
  ANIMACION
  DOCUMENTAL
  ROMANCE
  SUSPENSO
}

enum EstadoCompra {
  PAGADA
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  passwordHash String
  rol          Rol      @default(USUARIO)
  creadoEn     DateTime @default(now())

  compras Compra[]
}

model Sala {
  id          String    @id @default(cuid())
  nombre      String    @unique
  filas       Int
  columnas    Int
  creadaEn    DateTime  @default(now())
  eliminadaEn DateTime?

  butacas   Butaca[]
  funciones Funcion[]
}

model Butaca {
  id      String @id @default(cuid())
  fila    Int
  columna Int

  sala   Sala   @relation(fields: [salaId], references: [id], onDelete: Cascade)
  salaId String

  entradas Entrada[]

  @@unique([salaId, fila, columna])
  @@index([salaId])
}

model Pelicula {
  id              String        @id @default(cuid())
  titulo          String
  sinopsis        String
  duracionMinutos Int
  clasificacion   Clasificacion
  categoria       Categoria
  creadaEn        DateTime      @default(now())
  imagenUrl       String?
  bajaEn          DateTime?

  funciones Funcion[]
}

model Funcion {
  id     String   @id @default(cuid())
  inicio DateTime

  pelicula   Pelicula @relation(fields: [peliculaId], references: [id], onDelete: Restrict)
  peliculaId String

  sala   Sala   @relation(fields: [salaId], references: [id], onDelete: Restrict)
  salaId String

  entradas Entrada[]

  @@index([peliculaId])
  @@index([salaId])
}

model Compra {
  id       String       @id @default(cuid())
  estado   EstadoCompra @default(PAGADA)
  creadaEn DateTime     @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  usuarioId String

  entradas Entrada[]

  @@index([usuarioId])
}

model Entrada {
  id String @id @default(cuid())

  funcion   Funcion @relation(fields: [funcionId], references: [id], onDelete: Restrict)
  funcionId String

  butaca   Butaca @relation(fields: [butacaId], references: [id], onDelete: Restrict)
  butacaId String

  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId String

  @@unique([funcionId, butacaId])
  @@index([funcionId])
  @@index([butacaId])
  @@index([compraId])
}
