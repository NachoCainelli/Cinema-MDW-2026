# Variables de las pruebas de punta a punta (`pnpm test:e2e`).
#
# Este archivo SÍ se commitea: no tiene ningún secreto real. Todo apunta a la
# Postgres de `docker-compose.yml` y a valores que solo sirven acá.
#
# Lo carga `e2e/entorno.ts` (desde `playwright.config.ts` y `e2e/preparar.ts`).
# Una variable que ya esté definida en la terminal gana sobre este archivo; por
# eso la guarda de base local mira el valor final, no lo que dice acá.
#
# Cualquier variable de `.env.local` o `.env` que no esté acá se vacía antes de
# levantar la app: así ninguna credencial de producción (Supabase Storage,
# Google) llega al servidor de pruebas, aunque alguien agregue una nueva.

# Base local (docker-compose.yml). Las dos tienen que ser localhost o
# 127.0.0.1: si no, `playwright.config.ts` corta antes de lanzar el navegador.
DATABASE_URL="postgresql://cinema:cinema@localhost:5433/cinema_e2e"
DIRECT_URL="postgresql://cinema:cinema@localhost:5433/cinema_e2e"

# Secreto de prueba: con él `e2e/sesiones.ts` firma la cookie de sesión de
# Auth.js. No es el de producción ni tiene que parecerse.
AUTH_SECRET="secreto-de-prueba-e2e-no-sirve-en-produccion"

# `next start` corre con NODE_ENV=production, y ahí Auth.js solo acepta el host
# del request si se lo dice esta variable (en Vercel lo deduce solo).
AUTH_TRUST_HOST="true"

# Sin Google en las pruebas: las sesiones se fabrican en `e2e/sesiones.ts`.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Usuarios del seed. Los emails quedan en los valores por defecto
# (admin@ejemplo.com, gestor@ejemplo.com, usuario@ejemplo.com), que son los que
# busca `e2e/sesiones.ts`.
SEED_PASSWORD="password-de-prueba-e2e"
SEED_EMAIL_ADMIN=""
SEED_EMAIL_GESTOR=""

PRECIO_ENTRADA="5000"

# Todos los pagos simulados se aprueban: una prueba que quiera el 402 lo pide
# explícitamente, no depende del azar.
PAGO_MOCK_TASA_RECHAZO="0"

# Sin Storage: subir un póster en las pruebas devuelve el 502 de "no se pudo
# subir", nunca escribe en el bucket de producción.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
